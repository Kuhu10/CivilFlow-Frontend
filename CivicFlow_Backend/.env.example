# Application
APP_NAME=CivicFlow API
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Local PostgreSQL when running directly on your machine/Codespace.
# For docker compose, the compose file overrides host 'localhost' with the 'db' service name.
DATABASE_URL=postgresql+psycopg://civicflow:civicflow@localhost:5432/civicflow

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never use the placeholder in production.
SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated browser origins permitted to call this API.
# Add the deployed frontend origin before production deployment.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8501

# AI_PROVIDER can be: auto, gemini, ollama, rules
# auto uses Gemini when the key is present; otherwise it uses explicitly labelled rules fallback.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional local open-weight model via an Ollama server. Pull a vision-capable model (e.g. gemma3:4b) for photo analysis.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=90

# Evidence files are stored locally in development. Use private object storage for production.
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_MB=10

# Optional. If both are provided, `python -m app.seed` creates this first admin account.
# Do not commit real credentials to GitHub.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
